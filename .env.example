# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (servizio "db" in docker-compose.yml)
POSTGRES_USER=fusion
POSTGRES_PASSWORD=fusion
POSTGRES_DB=fusion_whatsapp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fusion:fusion@localhost:5432/fusion_whatsapp

# Redis (servizio "redis" in docker-compose.yml)
REDIS_PASSWORD=fusion
REDIS_PORT=6379
REDIS_URL=redis://:fusion@localhost:6379

# WhatsApp Cloud API (webhook receiver)
WHATSAPP_CLOUD_APP_SECRET=""
WHATSAPP_CLOUD_VERIFY_TOKEN=""

# Facebook Embedded Signup
FACEBOOK_APP_ID=""
FACEBOOK_EMBEDDED_SIGNUP_CONFIG_ID=""
FACEBOOK_APP_SECRET=""
# Opzionale: override del base URL della Graph API (test locali / endpoint regionali).
# Default se assente: https://graph.facebook.com
# GRAPH_API_BASE_URL=""

# Cifratura Access Token (AES-256-GCM) — stringa a 32 caratteri
ENCRYPTION_SECRET=""

# Auth.js / NextAuth
NEXTAUTH_SECRET=""

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price ID Stripe dei piani a pagamento (necessari per creare le Checkout Session)
STRIPE_PRICE_ID_TEAM=""
STRIPE_PRICE_ID_AGENCY=""
STRIPE_PRICE_ID_ENTERPRISE=""
# Opzionale: override del base URL delle API Stripe (solo per test locali)
# STRIPE_API_BASE_URL=""
